---
import type { SkillGroup } from '../types';
const { groups } = Astro.props as { groups: SkillGroup[] };
---
<div class="skill-grid">
  {groups.map((group, index) => (
    <section class="skill-card" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
      <div class="skill-card__head"><span>0{index + 1}</span><span>FIELD</span></div>
      <h3>{group.title}</h3>
      <ul>
        {group.items.map((item) => <li><span></span>{item}</li>)}
      </ul>
    </section>
  ))}
</div>
