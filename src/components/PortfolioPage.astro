---
import ExperienceTimeline from './ExperienceTimeline.astro';
import ProjectCard from './ProjectCard.astro';
import TechStackStrip from './TechStackStrip.astro';
import TerminalCTA from './TerminalCTA.astro';
import TerminalPanel from './TerminalPanel.astro';
import type { Lang, LocalizedContent } from '../types';

interface Props {
  content: LocalizedContent;
  lang: Lang;
}

const { content: c, lang } = Astro.props as Props;
const isSpanish = lang === 'es';
const languageHref = isSpanish ? '/en/' : '/es/';

const editorial = isSpanish
  ? {
      edition: 'Edición 01 · Córdoba, España',
      date: '12 SEPTIEMBRE 2026',
      status: 'En activo · ESG Innova Group',
      headerNote: 'Software con criterio y pulso humano',
      heroLead: 'Sistemas que',
      heroAccent: 'aguantan el ruido.',
      scroll: 'Desplaza para leer',
      selectedIntro: 'Una selección de problemas reales, decisiones técnicas y resultados que pueden sostenerse cuando el proyecto sale del papel.',
      issueLabel: 'El d-IA-rio del desarrollador',
      issueTitle: 'Código con oficio',
      issueCaption: 'Backend, operaciones y soporte unidos para que las cosas importantes sigan funcionando.',
      issueStamp: 'HECHO\nCON\nCUIDADO',
      ticker: ['ColdFusion', 'Lucee', 'React', 'Angular', 'Java', 'MySQL', 'MongoDB', 'Docker', 'Laravel', 'TestBox', 'Linux'],
      workKicker: '01 / TRABAJO SELECCIONADO',
      workTitle: 'Histor-IA-s de sistemas reales',
      workAside: 'No colecciono tecnolog-IA-s por moda. Me interesa entender el contexto, quitar fricción y dejar una solución más clara que la que encontré.',
      experienceKicker: '02 / EXPERIENC-IA PROFESIONAL',
      experienceTitle: 'Experienc-IA profesional',
      quote: 'La mejor solución no es la que más ruido hace. Es la que sigue respondiendo cuando todos los demás ya se han ido.',
      quoteByline: 'Nota de trabajo · JMAT',
      deskKicker: '03 / LA MESA DE TRABAJO',
      deskTitle: 'Herramientas para pensar y construir',
      deskIntro: 'Una base técnica práctica, con curiosidad por el detalle y respeto por el tiempo de las personas que usarán el producto.',
      contactKicker: '04 / CARTA ABIERTA',
      footerNote: 'Construido con Astro · Diseñado para ser leído con calma',
      languageLabel: 'English'
    }
  : {
      edition: 'Edition 01 · Córdoba, Spain',
      date: '12 SEPTEMBER 2026',
      status: 'Currently at · ESG Innova Group',
      headerNote: 'Software with judgement and human pulse',
      heroLead: 'Systems that',
      heroAccent: 'hold under noise.',
      scroll: 'Scroll to read',
      selectedIntro: 'A selection of real problems, technical decisions and outcomes designed to keep making sense beyond the first release.',
      issueLabel: 'The developer journal',
      issueTitle: 'Code with craft',
      issueCaption: 'Backend, operations and support working together so important things keep working.',
      issueStamp: 'MADE\nWITH\nCARE',
      ticker: ['ColdFusion', 'Lucee', 'React', 'Angular', 'Java', 'MySQL', 'MongoDB', 'Docker', 'Laravel', 'TestBox', 'Linux'],
      workKicker: '01 / SELECTED WORK',
      workTitle: 'Stories from real systems',
      workAside: 'I do not collect technologies for fashion. I care about understanding context, removing friction and leaving a clearer solution behind.',
      experienceKicker: '02 / PROFESSIONAL EXPERIENCE',
      experienceTitle: 'Professional experience',
      quote: 'The best solution is not the one that makes the most noise. It is the one that keeps responding after everyone else has left.',
      quoteByline: 'Working note · JMAT',
      deskKicker: '03 / THE WORKBENCH',
      deskTitle: 'Tools to think and build',
      deskIntro: 'A practical technical base, with curiosity for detail and respect for the time of the people who use the product.',
      contactKicker: '04 / OPEN LETTER',
      footerNote: 'Built with Astro · Designed to be read slowly',
      languageLabel: 'Español'
    };

const consoleOptions = isSpanish
  ? [
      { label: 'ColdFusion', command: 'tech --info coldFusion', detail: 'CFML para lógica de negocio y aplicaciones web.' },
      { label: 'Lucee', command: 'tech --info lucee', detail: 'Runtime CFML con el que trabajo en aplicaciones existentes.' },
      { label: 'React', command: 'tech --info react', detail: 'Interfaces componibles y estados interactivos.' },
      { label: 'Angular', command: 'tech --info angular', detail: 'Aplicaciones web estructuradas y mantenibles.' },
      { label: 'Java', command: 'tech --info java', detail: 'Desarrollo y soporte en ecosistemas JVM.' },
      { label: 'MySQL', command: 'tech --info mysql', detail: 'Consultas, datos relacionales y mantenimiento de aplicaciones.' },
      { label: 'MongoDB', command: 'tech --info mongodb', detail: 'Persistenc-IA documental para los casos que la requieren.' },
      { label: 'Docker', command: 'tech --info docker', detail: 'Tecnolog-IA conocida dentro del contexto de las aplicaciones, no como foco principal.' },
      { label: 'Laravel', command: 'tech --info laravel', detail: 'Framework PHP para aplicaciones web y servicios.' },
      { label: 'TestBox', command: 'tech --info testbox', detail: 'Framework de testing para ColdFusion/Lucee.' },
      { label: 'Linux', command: 'tech --info linux', detail: 'Entornos y soporte técnico dentro del trabajo diario.' }
    ]
  : [
      { label: 'ColdFusion', command: 'tech --info coldFusion', detail: 'CFML for business logic and web applications.' },
      { label: 'Lucee', command: 'tech --info lucee', detail: 'The CFML runtime I work with in existing applications.' },
      { label: 'React', command: 'tech --info react', detail: 'Composable interfaces and interactive state.' },
      { label: 'Angular', command: 'tech --info angular', detail: 'Structured and maintainable web applications.' },
      { label: 'Java', command: 'tech --info java', detail: 'Development and support across JVM ecosystems.' },
      { label: 'MySQL', command: 'tech --info mysql', detail: 'Queries, relational data and application maintenance.' },
      { label: 'MongoDB', command: 'tech --info mongodb', detail: 'Document persistence for the cases that need it.' },
      { label: 'Docker', command: 'tech --info docker', detail: 'Known in the application context, but not a primary focus.' },
      { label: 'Laravel', command: 'tech --info laravel', detail: 'PHP framework for web applications and services.' },
      { label: 'TestBox', command: 'tech --info testbox', detail: 'Testing framework for ColdFusion/Lucee.' },
      { label: 'Linux', command: 'tech --info linux', detail: 'Environments and technical support in day-to-day work.' }
    ];
---

<div class="portfolio-shell">
  <a class="skip-link" href="#main-content">{isSpanish ? 'Saltar al contenido' : 'Skip to content'}</a>

  <div class="paper-topline" aria-label={editorial.edition}>
    <span>{editorial.edition}</span>
    <span>{editorial.date}</span>
    <span class="paper-topline__status"><i></i>{editorial.status}</span>
  </div>

  <header class="site-header" data-header>
    <a class="masthead" href="#top" aria-label="JMAT Portfolio">
      <span class="masthead__mark">J</span>
      <span class="masthead__name">JMAT<span>.</span></span>
      <sup>26</sup>
    </a>
    <p class="site-header__note">{editorial.headerNote}</p>
    <nav class="site-nav" aria-label={isSpanish ? 'Navegación principal' : 'Main navigation'}>
      <a href="#top">{c.nav.home}</a>
      <a href="#projects">{c.nav.projects}</a>
      <a href="#experience">{c.nav.experience}</a>
      <a href="#about">{c.nav.about}</a>
      <a
        class="site-nav__linkedin"
        href="https://www.linkedin.com/in/juanmadator/"
        target="_blank"
        rel="noreferrer"
        aria-label={isSpanish ? 'Abrir perfil de LinkedIn' : 'Open LinkedIn profile'}
      >
        <svg class="site-nav__linkedin-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V8.999h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.287zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM3.555 20.452h3.558V8.999H3.555v11.453zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.454C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
        </svg>
      </a>
      <a class="site-nav__language" href={languageHref}>{editorial.languageLabel}<span>↗</span></a>
    </nav>
  </header>

  <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>

  <main id="main-content">
    <section class="hero-section page-frame" id="top" data-section data-section-index="00" data-section-label={isSpanish ? 'Portada' : 'Cover'}>
      <div class="hero-copy" data-reveal>
        <p class="eyebrow"><span class="eyebrow__line"></span><span class="eyebrow__text">{c.hero.kicker}</span></p>
        <h1 class="hero-title">
          <span>{editorial.heroLead}</span>
          <em>{editorial.heroAccent}</em>
        </h1>
        <p class="hero-intro">{c.hero.subheadline}</p>
        <div class="hero-actions">
          <a class="button button--ink" href="#projects">{c.hero.ctaPrimary}<span>↓</span></a>
          <a class="text-link" href="#about">{c.hero.ctaSecondary}<span>↗</span></a>
        </div>
        <div class="hero-footnote">
          <span class="hero-footnote__line"></span>
          <span>{c.profile.location} · {c.profile.education}</span>
        </div>
        <div class="hero-scroll-cue"><span></span>{editorial.scroll}<b>↓</b></div>
        <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="true">{isSpanish ? 'Animación completa · cambiar a suave' : 'Full animation · switch to gentle'}</button>
      </div>

      <div class="hero-visual" data-reveal style="--reveal-delay: 140ms">
        <article class="press-card">
          <div class="press-card__topline">
            <span>{editorial.issueLabel}</span>
            <span>VOL. 01 / 2026</span>
          </div>
          <div class="press-card__body">
            <p class="press-card__kicker">{c.profile.role}</p>
            <h2>{editorial.issueTitle}</h2>
            <div class="press-card__stamp" aria-hidden="true">
              {editorial.issueStamp.split('\n').map((line) => <span>{line}</span>)}
            </div>
            <div class="press-card__orbit" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <p class="press-card__caption">{editorial.issueCaption}</p>
          </div>
          <div class="press-card__footer">
            <span>JMAT / 001</span>
            <span>CORDOBA · ES</span>
          </div>
        </article>
        <TerminalPanel
          items={c.terminalLines}
          label={isSpanish ? 'Instantánea técnica' : 'Live technical snapshot'}
          options={consoleOptions}
          optionsLabel={isSpanish ? 'Opciones de tecnolog-IA' : 'Technology options'}
          optionsHint={isSpanish ? 'Pulsa una tecnolog-IA para consultar su contexto.' : 'Select a technology to inspect its context.'}
          statusPrefix={isSpanish ? 'Contexto cargado · ' : 'Context loaded · '}
        />
      </div>
    </section>

    <div class="editorial-ticker" aria-label={isSpanish ? 'Tecnologías y áreas de trabajo' : 'Technologies and areas of work'}>
      <div class="editorial-ticker__track">
        {[...editorial.ticker, ...editorial.ticker].map((item, index) => (
          <span class="editorial-ticker__item" aria-hidden={index >= editorial.ticker.length ? 'true' : undefined}>
            <i></i>{item}
          </span>
        ))}
      </div>
    </div>

    <section class="page-section page-frame" id="projects" data-section data-section-index="01" data-section-label={isSpanish ? 'Trabajo seleccionado' : 'Selected work'}>
      <div class="section-heading" data-reveal>
        <div>
          <p class="section-kicker">{editorial.workKicker}</p>
          <h2>{editorial.workTitle}</h2>
        </div>
        <p class="section-heading__number">01—{String(c.projects.length).padStart(2, '0')}</p>
      </div>
      <div class="projects-layout">
        <aside class="section-aside" data-reveal>
          <p class="section-aside__lead">{editorial.selectedIntro}</p>
          <p class="section-aside__note">{editorial.workAside}</p>
          <span class="section-aside__stamp">{isSpanish ? 'TRABAJO' : 'SELECTED'}<br />{isSpanish ? 'SELEC.' : 'WORK'}</span>
        </aside>
        <div class="project-grid">
          {c.projects.map((project, index) => <ProjectCard project={project} index={index} outcomeLabel={isSpanish ? 'Resultado' : 'Outcome'} />)}
        </div>
      </div>
    </section>

    <section class="page-section page-frame experience-section" id="experience" data-section data-section-index="02" data-section-label={isSpanish ? 'Experienc-IA profesional' : 'Professional experience'}>
      <div class="section-heading" data-reveal>
        <div>
          <p class="section-kicker">{editorial.experienceKicker}</p>
          <h2>{editorial.experienceTitle}</h2>
        </div>
        <p class="section-heading__number">02—{String(c.experience.length).padStart(2, '0')}</p>
      </div>
      <div class="experience-layout">
        <aside class="quote-card" data-reveal>
          <span class="quote-card__mark">“</span>
          <p class="quote-card__label">{isSpanish ? 'NOTA DEL EDITOR' : 'EDITORIAL NOTE'}</p>
          <blockquote>{editorial.quote}</blockquote>
          <cite>{editorial.quoteByline}</cite>
        </aside>
        <ExperienceTimeline items={c.experience} />
      </div>
    </section>

    <section class="page-section page-frame about-section" id="about" data-section data-section-index="03" data-section-label={isSpanish ? 'La mesa de trabajo' : 'The workbench'}>
      <div class="section-heading" data-reveal>
        <div>
          <p class="section-kicker">{editorial.deskKicker}</p>
          <h2>{editorial.deskTitle}</h2>
        </div>
        <p class="section-heading__number">03—∞</p>
      </div>
      <div class="about-layout">
        <article class="profile-note" data-reveal>
          <p class="profile-note__label">{c.sections.about}</p>
          <p class="profile-note__lead">{editorial.deskIntro}</p>
          <dl class="profile-facts">
            <div><dt>{isSpanish ? 'Nombre' : 'Name'}</dt><dd>{c.profile.fullName}</dd></div>
            <div><dt>{isSpanish ? 'Base' : 'Base'}</dt><dd>{c.profile.location}</dd></div>
            <div><dt>{isSpanish ? 'Formación' : 'Education'}</dt><dd>{c.profile.education}</dd></div>
            <div><dt>{isSpanish ? 'Situación' : 'Current focus'}</dt><dd>{c.profile.currentStatus}</dd></div>
            <div><dt>{isSpanish ? 'IA en el trabajo' : 'AI at work'}</dt><dd>{c.profile.aiStatement}</dd></div>
          </dl>
        </article>
        <div class="skills-panel" data-reveal style="--reveal-delay: 120ms">
          <div class="skills-panel__head">
            <span>{c.sections.skills}</span>
            <span>INDEX / {String(c.skills.length).padStart(3, '0')}</span>
          </div>
          <TechStackStrip groups={c.skills} />
        </div>
      </div>
    </section>

    <section class="page-frame contact-section" id="contact" data-section data-section-index="04" data-section-label={isSpanish ? 'Carta abierta' : 'Open letter'}>
      <TerminalCTA
        headline={c.contact.headline}
        text={c.contact.text}
        linkedinLabel={c.contact.linkedinLabel}
        emailLabel={c.contact.emailLabel}
        kicker={editorial.contactKicker}
        lang={lang}
      />
      <footer class="site-footer">
        <span>JMAT / PORTFOLIO</span>
        <span>{editorial.footerNote}</span>
        <a href="#top">↑ {isSpanish ? 'Volver arriba' : 'Back to top'}</a>
      </footer>
    </section>
  </main>
</div>

<script>
  const initializePortfolio = () => {
  const root = document.documentElement;
  const isSpanish = root.lang === 'es';
  root.classList.add('js');
  root.dataset.motion = 'full';
  const motionToggle = document.querySelector('[data-motion-toggle]');
  motionToggle?.addEventListener('click', () => {
    const full = root.dataset.motion !== 'full';
    root.dataset.motion = full ? 'full' : 'gentle';
    motionToggle.setAttribute('aria-pressed', String(full));
    motionToggle.textContent = isSpanish
      ? (full ? 'Animación completa · cambiar a suave' : 'Animación suave · activar completa')
      : (full ? 'Full animation · switch to gentle' : 'Gentle animation · enable full');
  });

  let previousScrollY = window.scrollY;
  let scrollDirection = 'down';
  root.dataset.scrollDirection = scrollDirection;

  const revealItems = document.querySelectorAll('[data-reveal]');
  const scrollMotionItems = Array.from(revealItems);
  const reveal = (element) => element.classList.add('is-visible');

  const getScrollDepth = (element) => {
    if (element.classList.contains('hero-visual')) return 1.45;
    if (element.classList.contains('hero-copy')) return 1.15;
    if (element.classList.contains('project-card')) return 0.78;
    if (element.classList.contains('skill-card')) return 0.7;
    return 0.55;
  };

  const updateScrollMotion = () => {
    const viewportHeight = Math.max(window.innerHeight, 1);
    const viewportCenter = viewportHeight * 0.5;

    scrollMotionItems.forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      const bounds = item.getBoundingClientRect();
      const itemCenter = bounds.top + bounds.height * 0.5;
      const relativePosition = (itemCenter - viewportCenter) / viewportHeight;
      const shift = Math.max(-16, Math.min(16, -relativePosition * getScrollDepth(item) * 20));
      item.style.setProperty('--scroll-shift', `${shift.toFixed(2)}px`);
    });
  };

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!(entry.target instanceof HTMLElement)) return;

          if (entry.isIntersecting) {
            entry.target.dataset.revealDirection = scrollDirection;
            reveal(entry.target);
          } else {
            entry.target.classList.remove('is-visible');
          }
        });
      },
      { rootMargin: '-8% 0px -12% 0px', threshold: 0.08 },
    );

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach(reveal);
  }

  const header = document.querySelector('[data-header]');
  const progress = document.querySelector('[data-scroll-progress]');
  const sectionTargets = Array.from(document.querySelectorAll('[data-section]'));
  let activeSection = null;
  let sectionTransitionTimer = 0;

  const triggerSectionTransition = (section, direction) => {
    if (!(section instanceof HTMLElement)) return;

    sectionTargets.forEach((candidate) => {
      if (candidate !== section) candidate.classList.remove('is-page-entering');
    });

    section.dataset.pageDirection = direction;
    section.classList.remove('is-page-entering');
    void section.offsetWidth;
    section.classList.add('is-page-entering');
    window.clearTimeout(sectionTransitionTimer);
    sectionTransitionTimer = window.setTimeout(() => section.classList.remove('is-page-entering'), 3000);
  };

  const updateActiveSection = (currentScrollY) => {
    if (!sectionTargets.length) return;

    const activationLine = currentScrollY + window.innerHeight * 0.38;
    let nextSection = sectionTargets[0];
    sectionTargets.forEach((section) => {
      const top = section.getBoundingClientRect().top + currentScrollY;
      if (top <= activationLine) nextSection = section;
    });

    if (nextSection === activeSection) return;
    const previousSection = activeSection;
    activeSection = nextSection;
    if (!previousSection) return;

    const previousTop = previousSection.getBoundingClientRect().top + currentScrollY;
    const nextTop = nextSection.getBoundingClientRect().top + currentScrollY;
    triggerSectionTransition(nextSection, nextTop >= previousTop ? 'down' : 'up');
  };

  const updateScrollState = () => {
    const currentScrollY = window.scrollY;
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = scrollable > 0 ? currentScrollY / scrollable : 0;

    if (currentScrollY > previousScrollY + 1) scrollDirection = 'down';
    if (currentScrollY < previousScrollY - 1) scrollDirection = 'up';
    root.dataset.scrollDirection = scrollDirection;

    if (header instanceof HTMLElement) {
      const hasScrolled = currentScrollY > 20;
      header.classList.toggle('is-scrolled', hasScrolled);
      header.classList.toggle('is-scrolling-down', hasScrolled && currentScrollY > 90 && scrollDirection === 'down');
      header.classList.toggle('is-scrolling-up', hasScrolled && scrollDirection === 'up');
    }
    root.classList.toggle('is-scroll-down', scrollDirection === 'down');
    root.classList.toggle('is-scroll-up', scrollDirection === 'up');
    if (progress) progress.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    updateScrollMotion();
    updateActiveSection(currentScrollY);
    previousScrollY = currentScrollY;
  };

  updateScrollState();
  window.addEventListener('scroll', updateScrollState, { passive: true });
  window.addEventListener('resize', updateScrollState, { passive: true });

  let scrollFrame = 0;
  const cancelScrollAnimation = () => {
    if (!scrollFrame) return;
    cancelAnimationFrame(scrollFrame);
    scrollFrame = 0;
  };

  const animateScrollTo = (target) => {
    cancelScrollAnimation();
    const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
    const destination = Math.max(0, target.getBoundingClientRect().top + window.scrollY - headerHeight - 14);
    const start = window.scrollY;
    const distance = destination - start;
    if (Math.abs(distance) < 2) return;

    const duration = Math.min(1100, Math.max(650, Math.abs(distance) * 0.55));
    const startedAt = performance.now();
    const easeInOut = (progress) => progress < 0.5
      ? 4 * progress * progress * progress
      : 1 - Math.pow(-2 * progress + 2, 3) / 2;

    const step = (now) => {
      const progress = Math.min(1, (now - startedAt) / duration);
      window.scrollTo(0, start + distance * easeInOut(progress));
      if (progress < 1) {
        scrollFrame = requestAnimationFrame(step);
      } else {
        scrollFrame = 0;
      }
    };

    scrollFrame = requestAnimationFrame(step);
  };

  window.addEventListener('wheel', cancelScrollAnimation, { passive: true });
  window.addEventListener('touchstart', cancelScrollAnimation, { passive: true });

  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const targetId = link.getAttribute('href');
      if (!targetId || targetId === '#') return;
      const target = document.querySelector(targetId);
      if (!target) return;

      event.preventDefault();
      animateScrollTo(target);
      history.replaceState(null, '', targetId);
    });
  });

  document.querySelectorAll('[data-console-option]').forEach((option) => {
    option.addEventListener('click', () => {
      const panel = option.closest('[data-terminal-panel]');
      if (!panel) return;

      panel.querySelectorAll('[data-console-option]').forEach((button) => {
        button.setAttribute('aria-pressed', button === option ? 'true' : 'false');
      });

      const command = panel.querySelector('[data-console-value="0"]');
      const detail = panel.querySelector('[data-console-value="1"]');
      const status = panel.querySelector('[data-console-status]');
      if (command) command.textContent = option.dataset.command ?? '';
      if (detail) detail.textContent = option.dataset.detail ?? '';
      if (status) status.textContent = `${panel.dataset.statusPrefix ?? ''}${option.dataset.label ?? ''}`;
    });
  });

  document.querySelectorAll('.project-card, .skill-card').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const bounds = card.getBoundingClientRect();
      card.style.setProperty('--pointer-x', `${event.clientX - bounds.left}px`);
      card.style.setProperty('--pointer-y', `${event.clientY - bounds.top}px`);
    });
    card.addEventListener('pointerleave', () => {
      card.style.removeProperty('--pointer-x');
      card.style.removeProperty('--pointer-y');
    });
  });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePortfolio, { once: true });
  } else {
    initializePortfolio();
  }
</script>
